# ───────────────────────────────────────────────────────────────────────────
# Copy these names into Vercel → Project → Settings → Environment Variables.
# NEVER put real values in this file or commit them to GitHub.
# ───────────────────────────────────────────────────────────────────────────

# Fine-grained GitHub token: "Only select repositories" → your PRIVATE data repo,
# Repository permissions → Contents: Read and write. Nothing else.
GITHUB_TOKEN=

# The PRIVATE repo where the data is saved, as owner/name (e.g. my-company/acs-data).
# Create it on GitHub as Private and tick "Add a README file" so it has a first commit.
GITHUB_REPO=

# Branch in the data repo (usually main).
GITHUB_BRANCH=main

# Two different long random secrets, at least 32 characters each.
# Make them with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CODE_PEPPER=
